{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/*.gen.ts",
      "!**/.tanstack",
      "!**/*.config.ts",
      "!**/*.config.mts",
      "!**/*.config.js",
      "!**/*.config.mjs",
      "!!**/dist",
      "!!**/dist-native",
      "!!**/.expo"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "es5",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "useButtonType": "off"
      },
      "complexity": {
        "noBannedTypes": "off"
      },
      "correctness": {
        "noUnusedVariables": {
          "level": "error",
          "options": {
            "ignoreRestSiblings": true
          }
        },
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "performance": {
        "noAccumulatingSpread": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "inlineType"
          }
        }
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "off"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@ui": "@core MUST NOT import from @ui",
                  "@core": "Use @/ inside @core, not package-style @core imports"
                },
                "patterns": [
                  {
                    "group": ["@/modules/**"],
                    "message": "shared MUST NOT import from modules"
                  },
                  {
                    "group": ["@ui/**", "apps/**", "packages/ui/**"],
                    "message": "@core MUST NOT import from @ui or apps"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@ui": "@core MUST NOT import from @ui",
                  "@core": "Use @core/modules/* or @core/shared inside apps; use @/ inside @core"
                },
                "patterns": [
                  {
                    "group": ["@/modules/*/**"],
                    "message": "Import other modules only via @/modules/{name}"
                  },
                  {
                    "group": ["@ui/**", "apps/**", "packages/ui/**"],
                    "message": "@core MUST NOT import from @ui or apps"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/**", "apps/mobile/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@core": "Use @core/modules/* or @core/shared"
                },
                "patterns": [
                  {
                    "group": ["@ui/*", "packages/ui/**"],
                    "message": "Import UI only via @ui"
                  },
                  {
                    "group": ["**/*.css.ts", "**/*.styles.ts"],
                    "message": "Styles belong in @ui only"
                  },
                  {
                    "group": ["apps/web/**", "apps/mobile/**"],
                    "message": "Apps MUST NOT import each other"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
