{
  "name": "messenger-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "turbo run format",
    "clean": "turbo run clean",
    "clean:all": "turbo run clean && rm -rf node_modules pnpm-lock.yaml",
    "syncpack:fix": "syncpack fix-mismatches",
    "syncpack:list": "syncpack list-mismatches",
    "commitlint": "commitlint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "25.0.3",
    "concurrently": "9.1.2",
    "dotenv-cli": "11.0.0",
    "husky": "9.1.7",
    "syncpack": "13.0.4",
    "turbo": "2.8.7",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.21.1",
    "pnpm": ">=10.0.0"
  }
}
